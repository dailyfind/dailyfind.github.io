rules_version = '2';
// DAILY FIND FRIENDS のデータの守り（Firestore セキュリティルール）
//
// ・ログインは「匿名ログイン」だけ（メール・パスワード・名前は使わない）
// ・グループの中身（メンバー・投稿）は、そのグループのメンバーだけが読める
// ・メンバーになるには、招待リンクに入っている「合言葉（key）」が必要
// ・投稿の編集は本人だけ、削除は本人かグループを作った人だけ
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function group(gid) { return get(groupPath(gid)).data; }
    function isMember(gid) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }
    function isOwner(gid) { return signedIn() && group(gid).owner == request.auth.uid; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function httpsOrEmpty(v) { return v is string && v.size() <= 500 && (v == "" || v.matches('^https://[^\\s"<>]+$')); }

    match /groups/{gid} {
      allow read: if isMember(gid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'key', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && str(request.resource.data.name, 1, 30)
        && str(request.resource.data.key, 20, 64)
        && request.resource.data.createdAt == request.time;
      // グループ名の変更・招待リンクの作り直しは作った人だけ（作った人は変えられない）
      allow update: if isOwner(gid)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['name', 'owner', 'key', 'createdAt'])
        && str(request.resource.data.name, 1, 30)
        && str(request.resource.data.key, 20, 64);
      allow delete: if isOwner(gid);

      match /members/{uid} {
        allow read: if isMember(gid) || (signedIn() && request.auth.uid == uid);
        // 参加：自分の分だけ、正しい合言葉を持っているときだけ
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nickname', 'key', 'joinedAt'])
          && str(request.resource.data.nickname, 1, 20)
          && request.resource.data.key == group(gid).key
          && request.resource.data.joinedAt == request.time;
        // ニックネームの変更は本人だけ
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nickname', 'key', 'joinedAt'])
          && request.resource.data.key == resource.data.key
          && request.resource.data.joinedAt == resource.data.joinedAt
          && str(request.resource.data.nickname, 1, 20);
        // 抜ける：本人。外す：グループを作った人
        allow delete: if (signedIn() && request.auth.uid == uid) || isOwner(gid);
      }

      match /posts/{pid} {
        function validPost(d) {
          return d.keys().hasOnly(['uid', 'nickname', 'category', 'title', 'by', 'oneline', 'link', 'image', 'rating', 'createdAt', 'updatedAt'])
            && d.uid == request.auth.uid
            && str(d.nickname, 1, 20)
            && d.category in ['本', '映画', '音楽', 'お店', 'アニメ', 'ゲーム', 'その他']
            && str(d.title, 1, 100)
            && str(d.by, 0, 100)
            && str(d.oneline, 0, 200)
            && httpsOrEmpty(d.link)
            && httpsOrEmpty(d.image)
            && d.rating is int && d.rating >= 0 && d.rating <= 5;
        }
        allow read: if isMember(gid);
        allow create: if isMember(gid) && validPost(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isMember(gid) && resource.data.uid == request.auth.uid
          && validPost(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner(gid));
      }
    }
  }
}
